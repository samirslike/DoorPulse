<Window x:Class="DoorPulse.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DoorPulse"
        Width="1180" Height="760"
        MinWidth="1000" MinHeight="680"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BgBrush}"
        Icon="Assets/doorpulse.ico">

    <Window.Resources>
        <Style x:Key="NavButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#DCE9F7"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Padding" Value="18,12"/>
            <Setter Property="Margin" Value="10,3"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Border" Background="{TemplateBinding Background}" CornerRadius="10">
                            <ContentPresenter Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#1AFFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="CornerRadius" Value="16"/>
            <Setter Property="Padding" Value="18"/>
            <Setter Property="BorderBrush" Value="{StaticResource LineBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Margin" Value="0,0,14,14"/>
        </Style>

        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="230"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Sidebar -->
        <Border Grid.Column="0" Background="#0D2A46">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Margin="20,22,18,16">
                    <StackPanel Orientation="Horizontal">
                        <Border Width="44" Height="44" CornerRadius="13" Background="#0B74D1">
                            <Image Source="Assets/doorpulse.png" Stretch="UniformToFill"/>
                        </Border>
                        <StackPanel Margin="11,1,0,0">
                            <TextBlock Text="DoorPulse" Foreground="White" FontSize="21" FontWeight="Bold"/>
                            <TextBlock Text="Recorder Manager" Foreground="#AFC6DD" FontSize="11"/>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Row="1" Margin="0,15,0,0">
                    <Button Style="{StaticResource NavButton}" Click="Dashboard_Click">●   Dashboard</Button>
                    <Button Style="{StaticResource NavButton}" Click="Videos_Click">▶   Videos</Button>
                    <Button Style="{StaticResource NavButton}" Click="Setup_Click">⚙   Settings</Button>
                    <Button Style="{StaticResource NavButton}" Click="Logs_Click">≡   Activity Logs</Button>
                    <Button Style="{StaticResource NavButton}" Click="Diagnostics_Click">✓   Diagnostics</Button>
                </StackPanel>

                <Border Grid.Row="2" Margin="16,14,16,18" Padding="12" CornerRadius="12" Background="#132F4C">
                    <StackPanel>
                        <TextBlock Text="Recorder status" Foreground="#AFC6DD" FontSize="11"/>
                        <TextBlock x:Name="SidebarStatus" Text="Checking..." Foreground="White" FontWeight="SemiBold" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- Main -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="74"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border Background="White" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1">
                <Grid Margin="24,0">
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock x:Name="PageTitle" Text="Dashboard" FontSize="24" FontWeight="Bold" Foreground="{StaticResource TextBrush}"/>
                        <TextBlock x:Name="PageSubtitle" Text="Monitor your recorder and recent activity." Foreground="{StaticResource MutedBrush}" FontSize="12"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Border x:Name="TopStatusPill" Background="#EEF2F6" CornerRadius="14" Padding="11,6">
                            <TextBlock x:Name="TopStatusText" Text="Checking..." FontWeight="SemiBold" Foreground="#475467"/>
                        </Border>
                        <Button Margin="10,0,0,0" Style="{StaticResource SecondaryButton}" Click="OpenViewer_Click">Open Viewer</Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- DASHBOARD -->
            <ScrollViewer x:Name="DashboardPage" Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="24">
                    <UniformGrid Columns="4">
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="RECORDER" Style="{StaticResource FieldLabel}"/>
                                <TextBlock x:Name="DashRecorder" Text="Checking..." FontSize="20" FontWeight="Bold"/>
                                <TextBlock Text="Windows background task" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,5,0,0"/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="CAMERAS" Style="{StaticResource FieldLabel}"/>
                                <TextBlock x:Name="DashRing" Text="Checking..." FontSize="20" FontWeight="Bold"/>
                                <TextBlock Text="Ring cameras monitored" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,5,0,0"/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="RECORDING" Style="{StaticResource FieldLabel}"/>
                                <TextBlock x:Name="DashLength" Text="25 sec" FontSize="20" FontWeight="Bold"/>
                                <TextBlock Text="Push-first capture" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,5,0,0"/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="HOSTINGER" Style="{StaticResource FieldLabel}"/>
                                <TextBlock x:Name="DashFtp" Text="Not configured" FontSize="20" FontWeight="Bold"/>
                                <TextBlock Text="Cloud upload target" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,5,0,0"/>
                            </StackPanel>
                        </Border>
                    </UniformGrid>

                    <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Recorder Control" FontSize="18" FontWeight="Bold"/>
                                <TextBlock Text="Start, stop or restart the background recorder without PowerShell." Foreground="{StaticResource MutedBrush}" Margin="0,5,0,0"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <Button Style="{StaticResource PrimaryButton}" Click="Start_Click">Start</Button>
                                <Button Style="{StaticResource SecondaryButton}" Margin="8,0,0,0" Click="Restart_Click">Restart</Button>
                                <Button Style="{StaticResource SecondaryButton}" Margin="8,0,0,0" Click="Stop_Click">Stop</Button>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource Card}" Margin="0">
                        <StackPanel>
                            <Grid Margin="0,0,0,12">
                                <TextBlock Text="Recent Activity" FontSize="18" FontWeight="Bold"/>
                                <Button HorizontalAlignment="Right" Style="{StaticResource SecondaryButton}" Click="RefreshLog_Click">Refresh</Button>
                            </Grid>
                            <TextBox x:Name="DashboardLog"
                                     Height="285"
                                     IsReadOnly="True"
                                     AcceptsReturn="True"
                                     TextWrapping="NoWrap"
                                     VerticalScrollBarVisibility="Auto"
                                     HorizontalScrollBarVisibility="Auto"
                                     FontFamily="Consolas"
                                     FontSize="12"
                                     Background="#0F172A"
                                     Foreground="#DDE7F0"
                                     BorderThickness="0"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>


            <!-- VIDEOS -->
            <Grid x:Name="VideosPage" Grid.Row="1" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Professional library header -->
                <Border Background="White" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1" Padding="24,16">
                    <Grid>
                        <StackPanel>
                            <TextBlock Text="Video Library" FontSize="21" FontWeight="Bold" Foreground="{StaticResource TextBrush}"/>
                            <TextBlock x:Name="VideoLibrarySummary" Text="Your locally stored DoorPulse events." Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,4,0,0"/>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <ComboBox x:Name="VideoCameraFilter" Width="180" SelectionChanged="VideoFilter_Changed">
                                <ComboBoxItem Content="All cameras"/>
                            </ComboBox>

                            <ComboBox x:Name="VideoEventFilter" Width="145" Margin="8,0,0,0" SelectionChanged="VideoFilter_Changed">
                                <ComboBoxItem Content="All events"/>
                                <ComboBoxItem Content="Motion"/>
                                <ComboBoxItem Content="Doorbell"/>
                            </ComboBox>

                            <TextBox x:Name="VideoSearchBox"
                                     Width="190"
                                     Height="38"
                                     Margin="8,0,0,0"
                                     ToolTip="Search camera or filename"
                                     TextChanged="VideoSearchBox_TextChanged"/>

                            <Button Style="{StaticResource SecondaryButton}" Margin="8,0,0,0" Click="RefreshVideos_Click">Refresh</Button>
                            <Button Style="{StaticResource SecondaryButton}" Margin="8,0,0,0" Click="OpenVideoFolder_Click">Open Folder</Button>
                        </StackPanel>
                    </Grid>
                </Border>

                <Grid Grid.Row="1" Margin="24">
                    <!-- Cloud-only state -->
                    <Border x:Name="CloudOnlyVideosPanel"
                            Visibility="Collapsed"
                            Background="White"
                            CornerRadius="18"
                            BorderBrush="{StaticResource LineBrush}"
                            BorderThickness="1"
                            Padding="40">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Width="520">
                            <Border Width="82" Height="82" CornerRadius="24" Background="#EEF7FF">
                                <TextBlock Text="☁" FontSize="40" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="Videos are stored in the cloud" FontSize="24" FontWeight="Bold" Foreground="{StaticResource TextBrush}" Margin="0,20,0,0" HorizontalAlignment="Center"/>
                            <TextBlock Text="This DoorPulse installation is currently set to Cloud Only. Choose Local or Local + Cloud in Settings to keep a local video library on this PC."
                                       Foreground="{StaticResource MutedBrush}" FontSize="14" TextWrapping="Wrap" TextAlignment="Center" Margin="0,10,0,0"/>
                            <Button Style="{StaticResource PrimaryButton}" Margin="0,22,0,0" Click="OpenViewer_Click">Open Cloud Viewer</Button>
                        </StackPanel>
                    </Border>

                    <!-- Empty state -->
                    <Border x:Name="EmptyVideosPanel"
                            Visibility="Collapsed"
                            Background="White"
                            CornerRadius="18"
                            BorderBrush="{StaticResource LineBrush}"
                            BorderThickness="1"
                            Padding="40">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Width="500">
                            <Border Width="82" Height="82" CornerRadius="24" Background="#F3F6F9">
                                <TextBlock Text="▶" FontSize="34" Foreground="#718096" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="No local recordings yet" FontSize="24" FontWeight="Bold" Foreground="{StaticResource TextBrush}" Margin="0,20,0,0" HorizontalAlignment="Center"/>
                            <TextBlock Text="When DoorPulse records an event, it will appear here automatically with its thumbnail, camera, time and event type."
                                       Foreground="{StaticResource MutedBrush}" FontSize="14" TextWrapping="Wrap" TextAlignment="Center" Margin="0,10,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- Video grid -->
                    <ScrollViewer x:Name="VideoScrollViewer" VerticalScrollBarVisibility="Auto">
                        <ItemsControl x:Name="VideoItemsControl">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel IsItemsHost="True"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>

                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Width="300"
                                            Margin="0,0,16,16"
                                            Background="White"
                                            CornerRadius="16"
                                            BorderBrush="#E3E8EE"
                                            BorderThickness="1"
                                            Cursor="Hand"
                                            MouseLeftButtonUp="VideoCard_Click">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="168"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>

                                            <!-- thumbnail -->
                                            <Grid Background="#0D1622" ClipToBounds="True">
                                                <Image Source="{Binding ThumbnailPath}" Stretch="UniformToFill"/>

                                                <Border Background="#65000000" CornerRadius="18" Width="48" Height="48" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                    <TextBlock Text="▶" Foreground="White" FontSize="22" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="3,0,0,0"/>
                                                </Border>

                                                <Border HorizontalAlignment="Left" VerticalAlignment="Top" Margin="10" Background="#D9111720" CornerRadius="8" Padding="8,4">
                                                    <TextBlock Text="{Binding EventLabel}" Foreground="White" FontSize="11" FontWeight="SemiBold"/>
                                                </Border>

                                                <Border HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="10" Background="#D9111720" CornerRadius="8" Padding="8,4">
                                                    <TextBlock Text="{Binding TimeText}" Foreground="White" FontSize="11" FontWeight="SemiBold"/>
                                                </Border>
                                            </Grid>

                                            <!-- details -->
                                            <Grid Grid.Row="1" Margin="14">
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                </Grid.RowDefinitions>

                                                <TextBlock Text="{Binding CameraName}" FontSize="16" FontWeight="Bold" Foreground="{StaticResource TextBrush}" TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Grid.Row="1" Text="{Binding DateText}" Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,5,0,0"/>

                                                <Grid Grid.Row="2" Margin="0,12,0,0">
                                                    <TextBlock Text="{Binding SizeText}" Foreground="#8992A3" FontSize="11" VerticalAlignment="Center"/>
                                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                                        <Button Tag="{Binding}" Style="{StaticResource SecondaryButton}" Padding="10,5" Click="PlayVideoButton_Click">Play</Button>
                                                        <Button Tag="{Binding}" Style="{StaticResource SecondaryButton}" Padding="10,5" Margin="6,0,0,0" Click="DeleteVideoButton_Click">Delete</Button>
                                                    </StackPanel>
                                                </Grid>
                                            </Grid>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Grid>

            <!-- SETUP -->
            <ScrollViewer x:Name="SetupPage" Grid.Row="1" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                <StackPanel Margin="24">

                    <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                        <StackPanel>
                            <TextBlock Text="Ring Connection" FontSize="18" FontWeight="Bold"/>
                            <TextBlock Text="Paste a refresh token only when setting up or reconnecting. Existing tokens remain hidden." Foreground="{StaticResource MutedBrush}" Margin="0,5,0,16"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="2*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Margin="0,0,12,0">
                                    <TextBlock Text="Ring refresh token" Style="{StaticResource FieldLabel}"/>
                                    <PasswordBox x:Name="RingTokenBox"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="Selected cameras" Style="{StaticResource FieldLabel}"/>
                                    <TextBox x:Name="CameraNameBox" IsReadOnly="True" Background="#F8FAFC"/>
                                </StackPanel>
                            </Grid>
                            <TextBlock x:Name="SavedTokenNote" Text="" Foreground="#16803B" Margin="0,10,0,0"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                        <StackPanel>
                            <TextBlock Text="Recording" FontSize="18" FontWeight="Bold"/>
                            <Grid Margin="0,16,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Margin="0,0,12,0">
                                    <TextBlock Text="Length preset" Style="{StaticResource FieldLabel}"/>
                                    <ComboBox x:Name="PresetBox">
                                        <ComboBoxItem Content="short"/>
                                        <ComboBoxItem Content="normal"/>
                                        <ComboBoxItem Content="long"/>
                                    </ComboBox>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Margin="0,0,12,0">
                                    <TextBlock Text="Cooldown seconds" Style="{StaticResource FieldLabel}"/>
                                    <TextBox x:Name="CooldownBox"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2" Margin="0,0,12,0">
                                    <TextBlock Text="Backup poll seconds" Style="{StaticResource FieldLabel}"/>
                                    <TextBox x:Name="PollBox"/>
                                </StackPanel>
                                <StackPanel Grid.Column="3">
                                    <TextBlock Text="Local retention hours" Style="{StaticResource FieldLabel}"/>
                                    <TextBox x:Name="RetentionBox"/>
                                </StackPanel>
                            </Grid>
                            <StackPanel Margin="0,14,0,0">
                                <TextBlock Text="Temporary recording folder" Style="{StaticResource FieldLabel}"/>
                                <TextBox x:Name="RecordingDirectoryBox"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                        <StackPanel>
                            <TextBlock Text="Hostinger / FTP" FontSize="18" FontWeight="Bold"/>
                            <Grid Margin="0,16,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Margin="0,0,12,0">
                                    <TextBlock Text="FTP host / IP" Style="{StaticResource FieldLabel}"/>
                                    <TextBox x:Name="FtpHostBox"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="FTP username" Style="{StaticResource FieldLabel}"/>
                                    <TextBox x:Name="FtpUserBox"/>
                                </StackPanel>
                            </Grid>
                            <Grid Margin="0,14,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Margin="0,0,12,0">
                                    <TextBlock Text="FTP password" Style="{StaticResource FieldLabel}"/>
                                    <PasswordBox x:Name="FtpPasswordBox"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="Remote recordings folder" Style="{StaticResource FieldLabel}"/>
                                    <TextBox x:Name="FtpRemoteBox"/>
                                </StackPanel>
                            </Grid>
                            <StackPanel Margin="0,14,0,0">
                                <TextBlock Text="Mobile viewer URL" Style="{StaticResource FieldLabel}"/>
                                <TextBox x:Name="ViewerUrlBox"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                        <StackPanel>
                            <TextBlock Text="Runtime Paths" FontSize="18" FontWeight="Bold"/>
                            <Grid Margin="0,16,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Margin="0,0,12,0">
                                    <TextBlock Text="Node.js executable" Style="{StaticResource FieldLabel}"/>
                                    <TextBox x:Name="NodePathBox"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="FFmpeg executable" Style="{StaticResource FieldLabel}"/>
                                    <TextBox x:Name="FfmpegPathBox"/>
                                </StackPanel>
                            </Grid>
                            <StackPanel Margin="0,14,0,0">
                                <TextBlock Text="Recorder script path" Style="{StaticResource FieldLabel}"/>
                                <TextBox x:Name="ScriptPathBox"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,24">
                        <Button Style="{StaticResource PrimaryButton}" Click="SaveApply_Click">Save &amp; Apply</Button>
                        <Button Style="{StaticResource SecondaryButton}" Margin="10,0,0,0" Click="RunSetupWizard_Click">Run Setup Wizard</Button>
                        <Button Style="{StaticResource SecondaryButton}" Margin="10,0,0,0" Click="ImportExisting_Click">Import Existing Ring Setup</Button>
                        <Button Style="{StaticResource SecondaryButton}" Margin="10,0,0,0" Click="InstallStartup_Click">Install / Update Startup</Button>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>

            <!-- LOGS -->
            <Grid x:Name="LogsPage" Grid.Row="1" Visibility="Collapsed" Margin="24">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Grid Margin="0,0,0,12">
                    <TextBlock Text="Recorder Activity" FontSize="18" FontWeight="Bold"/>
                    <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                        <Button Style="{StaticResource SecondaryButton}" Click="RefreshLog_Click">Refresh</Button>
                        <Button Style="{StaticResource SecondaryButton}" Margin="8,0,0,0" Click="OpenLogFolder_Click">Open Log Folder</Button>
                    </StackPanel>
                </Grid>
                <TextBox x:Name="FullLog"
                         Grid.Row="1"
                         IsReadOnly="True"
                         AcceptsReturn="True"
                         TextWrapping="NoWrap"
                         VerticalScrollBarVisibility="Auto"
                         HorizontalScrollBarVisibility="Auto"
                         FontFamily="Consolas"
                         FontSize="12"
                         Background="#0F172A"
                         Foreground="#DDE7F0"
                         BorderThickness="0"/>
            </Grid>

            <!-- DIAGNOSTICS -->
            <ScrollViewer x:Name="DiagnosticsPage" Grid.Row="1" Visibility="Collapsed">
                <StackPanel Margin="24">
                    <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                        <Grid>
                            <StackPanel>
                                <TextBlock Text="System Diagnostics" FontSize="18" FontWeight="Bold"/>
                                <TextBlock Text="Verify everything DoorPulse needs on this PC." Foreground="{StaticResource MutedBrush}" Margin="0,5,0,0"/>
                            </StackPanel>
                            <Button HorizontalAlignment="Right" Style="{StaticResource PrimaryButton}" Click="RunDiagnostics_Click">Run Diagnostics</Button>
                        </Grid>
                    </Border>
                    <StackPanel x:Name="DiagnosticsList"/>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</Window>
